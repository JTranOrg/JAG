{
  "#element(blobservices)":
  {
     "type":        "Microsoft.Storage/storageAccounts/blobServices",
     "apiVersion":  "2023-05-01",
     "name":        "[concat(StorageName, '/default')]",
     "dependsOn": 
     [
         "[resourceId('Microsoft.Storage/storageAccounts', StorageName)]"
     ],
     "sku": 
     {
  		 "name":			        "#(coalesce(Sku.Name, 'Standard_LRS'))",
  		 "tier":			        "#(coalesce(Sku.Tier, 'Standard')"
     },
     "properties": 
     {
         "cors": 
         {
             "corsRules": []
         },
         "deleteRetentionPolicy": 
         {
             "allowPermanentDelete": false,
             "enabled": false
         }
     }
  },

  "#element(blobservices-meta)":
  {
    "#arrayitem(1)": 
    {
      "Type":       "blobservices",
      "Name":       "#(StorageName + '/default')"
    }
  }
}

{
            "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
            "apiVersion": "2023-05-01",
            "name": "[concat(parameters('storageAccounts_fredbobjim_name'), '/default/bob')]",
            "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts/blobServices', parameters('storageAccounts_fredbobjim_name'), 'default')]",
                "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccounts_fredbobjim_name'))]"
            ],
            "properties": {
                "immutableStorageWithVersioning": {
                    "enabled": false
                },
                "defaultEncryptionScope": "$account-encryption-key",
                "denyEncryptionScopeOverride": false,
                "publicAccess": "None"
            }
        }