{
  "#include":    "*",

  "#variable(basename)": "rota-inventory",

  "#deployment()": 
  {
    "basename":    "#($basename)",
    "environment": "#($environment)",

    "functionapps": 
    [
      {
        "basename": "#($basename + '-etl')"
      },
      {
        "basename": "#($basename + '-transaction')",
        "storageaccount":  
        {
          "basename": "#($basename + '-ships')",

          "blobcontainers": 
          [
            "flights",
            "persons",
            "ships"
          ]
        }
      }
    ],

    "apis": 
    [
      "#($basename)"
    ],

    "messagequeues":        
    [
      "nightlybatch",
      "addperson",
      "addflight",
      "flightarrive",
      "deleteflight"
    ],

    "databasecontainers":             
    [
      "flights",
      "persons",
      "ships"
    ],

    "configuration": 
    {
      "MaxRetries":   5,
      "DeleteFlightQueue":  "deleteflight"
    }
  }
}