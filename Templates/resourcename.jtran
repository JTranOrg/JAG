{
  "#element(resourcename, resourcetype, basename, environment)": 
  { 
    "return":  "#(resourcename($resourcetype, $basename, coalesce($environment, 'dev')))"
  },

  "#function(resourcename, resourcetype, basename, environment)": 
  { 
    "#variable(prefix)":        
    {
      "#map($resourcetype)": 
      {
        "#mapitem('api')":                    "api",
        "#mapitem('appconfiguration')":       "appcs",
        "#mapitem('applicationinsights')":    "ai",
        "#mapitem('appserviceplan')":         "asp",
        "#mapitem('functionapp')":            "func",
        "#mapitem('keyvault')":               "kv",
        "#mapitem('loganalyticsworkspace')":  "log",
        "#mapitem('resourcegroup')":          "rg",
        "#mapitem('servicebus')":             "sb",
        "#mapitem('storageaccount')":         "sto",
        "#mapitem":                           ""
      }
    },

    "#if($resourcetype == 'storageaccount')":  
    {
      "return":     "#($prefix + replace($basename, '-', '') + $environment)"
    },
    "#else":
    {
       "return":    "#($prefix + '-' + $basename + '-' + $environment)"
    }
  }
}